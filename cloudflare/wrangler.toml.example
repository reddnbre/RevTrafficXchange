name = "revtrafficxchange-api"
main = "cloudflare/worker.js"
compatibility_date = "2026-05-29"

# After creating the D1 database, replace database_id.
[[d1_databases]]
binding = "DB"
database_name = "revtrafficxchange"
database_id = "replace-with-your-d1-database-id"

# Optional if using a custom domain route instead of workers.dev.
# routes = [
#   { pattern = "revtrafficxchange.com/api/*", zone_name = "revtrafficxchange.com" }
# ]
